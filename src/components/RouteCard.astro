---
import Badge from './starwind/Badge.astro';
import RouteTopos from './RouteTopos.astro';
const { route, sectorNumber, topos = [] } = Astro.props;
const grade = route.data.grade ?? '¿?';
const searchableText = `${route.data.name} ${grade}`.toLowerCase();
const pitchesLabel = route.data.pitches
  ? `${route.data.pitches} ${route.data.pitches === 1 ? 'largo' : 'largos'}${route.data.pitchesApproximate ? '?' : ''}`
  : undefined;
const lengthLabel = route.data.length
  ? `${route.data.length} m${route.data.lengthApproximate ? '?' : ''}`
  : undefined;
---
<article class="route-card card p-5" data-search={searchableText} data-sector={route.data.sector}>
  <div>
    <div class="flex items-start justify-between gap-4">
      <div>
        <div class="flex flex-wrap items-center gap-2">
          {route.data.order && <p class="inline-flex rounded-md bg-clay-500 px-3 py-1.5 text-base font-black uppercase tracking-wide" style="color:#17352a">Vía {route.data.order}</p>}
          {sectorNumber && <Badge>Sector {sectorNumber}</Badge>}
        </div>
        <h3 class="mt-3 text-xl font-black tracking-tight"><a class="focus-ring rounded-sm hover:underline" href={`/vias/${route.id}/`}>{route.data.name}</a></h3>
      </div>
      <span class="rounded-lg bg-basalt-900 px-3 py-2 text-xl font-black text-white">{grade}</span>
    </div>
    {route.data.restriction && <p class="mt-3 rounded-md bg-clay-500/15 p-3 text-xs font-bold leading-5 text-basalt-900">{route.data.restriction}</p>}
    {route.data.warning && <p class="mt-3 rounded-md bg-clay-500/15 p-3 text-xs font-bold leading-5 text-basalt-900">{route.data.warning}</p>}
    <div class="mt-5 flex flex-wrap gap-2">
      {route.data.status && <Badge>{route.data.status}</Badge>}
      {pitchesLabel && <Badge>{pitchesLabel}</Badge>}
      {lengthLabel && <Badge>{lengthLabel}</Badge>}
      {route.data.protection && <Badge>{route.data.protection}</Badge>}
      <Badge>Escalada deportiva</Badge>
    </div>
    <div class="mt-5 border-t border-current/10 pt-4">
      <p class="text-xs font-black uppercase tracking-widest opacity-55">Información aportada</p>
      <p class="mt-2 whitespace-pre-wrap text-sm font-medium leading-6">{route.data.sourceText}</p>
    </div>
    {topos.length > 0 && <RouteTopos routeId={route.id} routeName={route.data.name} topos={topos} />}
  </div>
</article>
