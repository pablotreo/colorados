<aside id="pwa-update-prompt" class="fixed inset-x-4 bottom-4 z-[60] mx-auto hidden max-w-xl rounded-2xl border border-white/15 bg-basalt-950 p-5 text-white shadow-2xl" role="dialog" aria-labelledby="pwa-update-title" aria-describedby="pwa-update-description" transition:persist="pwa-update-prompt">
  <div class="flex items-start gap-4">
    <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-clay-500 font-black text-basalt-950" aria-hidden="true">↻</span>
    <div class="min-w-0 flex-1">
      <p class="eyebrow text-clay-500">Actualización de la guía</p>
      <h2 id="pwa-update-title" class="mt-2 text-xl font-black">Nueva versión disponible</h2>
      <p id="pwa-update-description" class="mt-2 text-sm leading-6 text-white/70">Hay sectores, vías o correcciones nuevas listas para descargar.</p>
      <ul id="pwa-update-changes" class="mt-3 hidden list-disc space-y-1 pl-5 text-sm text-white/70"></ul>
      <div class="mt-5 flex flex-wrap gap-3">
        <button id="pwa-update-now" type="button" class="focus-ring min-h-11 cursor-pointer rounded-md bg-clay-500 px-5 py-2 text-sm font-black text-basalt-950 transition hover:bg-clay-600 disabled:cursor-wait disabled:opacity-60">Actualizar ahora</button>
        <button id="pwa-update-later" type="button" class="focus-ring min-h-11 cursor-pointer rounded-md border border-white/25 px-5 py-2 text-sm font-bold transition hover:bg-white/10">Más tarde</button>
      </div>
    </div>
  </div>
</aside>

<script>
  import { registerSW } from 'virtual:pwa-register';

  interface GuideVersion {
    version?: string;
    date?: string;
    changes?: string[];
  }

  const prompt = document.querySelector<HTMLElement>('#pwa-update-prompt');
  const title = document.querySelector<HTMLElement>('#pwa-update-title');
  const description = document.querySelector<HTMLElement>('#pwa-update-description');
  const changes = document.querySelector<HTMLUListElement>('#pwa-update-changes');
  const updateButton = document.querySelector<HTMLButtonElement>('#pwa-update-now');
  const laterButton = document.querySelector<HTMLButtonElement>('#pwa-update-later');
  const versionStorageKey = 'colorados-guide-version';
  let publishedVersion: string | undefined;
  let updateWaiting = false;

  function openPrompt() {
    prompt?.classList.remove('hidden');
  }

  function closePrompt() {
    prompt?.classList.add('hidden');
  }

  function readStoredVersion() {
    try {
      return localStorage.getItem(versionStorageKey);
    } catch {
      return null;
    }
  }

  function storeVersion(version: string) {
    try {
      localStorage.setItem(versionStorageKey, version);
    } catch {
      // El aviso sigue funcionando durante esta sesión aunque el almacenamiento esté bloqueado.
    }
  }

  function renderChanges(guide: GuideVersion) {
    if (!changes) return;
    if (!guide.changes?.length) {
      changes.classList.add('hidden');
      return;
    }
    changes.replaceChildren(...guide.changes.map((change) => {
      const item = document.createElement('li');
      item.textContent = change;
      return item;
    }));
    changes.classList.remove('hidden');
  }

  async function fetchVersionDetails() {
    try {
      const response = await fetch(`/guide-version.json?t=${Date.now()}`, { cache: 'no-store' });
      if (!response.ok) return undefined;
      return await response.json() as GuideVersion;
    } catch {
      return undefined;
    }
  }

  async function loadVersionDetails() {
    const guide = await fetchVersionDetails();
    if (!guide) return;
    publishedVersion = guide.version;
    try {
      if (title && guide.version) title.textContent = `Nueva versión ${guide.version} disponible`;
      if (description && guide.date) {
        const date = new Date(`${guide.date}T12:00:00`).toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' });
        description.textContent = `Publicada el ${date}. Puedes actualizar ahora o conservar la versión actual durante esta consulta.`;
      }
      renderChanges(guide);
    } catch {
      // El aviso básico sigue disponible aunque no cargue el resumen.
    }
  }

  async function checkActivatedVersion() {
    if (updateWaiting || !navigator.onLine) return;
    const guide = await fetchVersionDetails();
    if (!guide?.version) return;
    publishedVersion = guide.version;
    const storedVersion = readStoredVersion();
    const isInstalled = window.matchMedia('(display-mode: standalone)').matches
      || (navigator as Navigator & { standalone?: boolean }).standalone === true;
    if (!storedVersion) {
      storeVersion(guide.version);
      if (!isInstalled) return;
    }
    if (storedVersion === guide.version) return;

    storeVersion(guide.version);
    if (title) {
      title.textContent = storedVersion
        ? `Guía actualizada a la versión ${guide.version}`
        : `Versión ${guide.version} instalada`;
    }
    if (description) {
      description.textContent = guide.date
        ? `La actualización publicada el ${new Date(`${guide.date}T12:00:00`).toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' })} ya está instalada.`
        : 'La nueva versión de la guía ya está instalada.';
    }
    renderChanges(guide);
    updateButton?.classList.add('hidden');
    if (laterButton) laterButton.textContent = 'Entendido';
    openPrompt();
  }

  const updateSW = registerSW({
    immediate: true,
    onNeedRefresh() {
      updateWaiting = true;
      if (title) title.textContent = 'Nueva versión disponible';
      if (description) description.textContent = 'Hay sectores, vías o correcciones nuevas listas para descargar.';
      if (updateButton) updateButton.classList.remove('hidden');
      if (laterButton) laterButton.textContent = 'Más tarde';
      openPrompt();
      void loadVersionDetails();
    },
    onOfflineReady() {
      if (title) title.textContent = 'Guía lista para usar offline';
      if (description) description.textContent = 'Los sectores, vías e imágenes guardados ya están disponibles sin conexión.';
      changes?.classList.add('hidden');
      updateButton?.classList.add('hidden');
      if (laterButton) laterButton.textContent = 'Entendido';
      openPrompt();
    },
    onRegisteredSW(_swUrl, registration) {
      if (!registration) return;
      window.setInterval(() => {
        if (navigator.onLine) void registration.update();
      }, 60 * 60 * 1000);
    },
    onRegisterError(error) {
      console.error('No se pudo registrar la PWA de Colorados.', error);
    },
  });

  updateButton?.addEventListener('click', async () => {
    if (!navigator.onLine) {
      if (description) description.textContent = 'Necesitas conexión para descargar la nueva versión. Puedes intentarlo nuevamente cuando recuperes cobertura.';
      return;
    }
    updateButton.disabled = true;
    updateButton.textContent = 'Actualizando…';
    try {
      if (publishedVersion) storeVersion(publishedVersion);
      await updateSW(true);
    } catch {
      updateButton.disabled = false;
      updateButton.textContent = 'Actualizar ahora';
      if (description) description.textContent = 'No pudimos completar la actualización. Tu versión actual sigue disponible.';
    }
  });

  laterButton?.addEventListener('click', closePrompt);
  window.setTimeout(() => void checkActivatedVersion(), 1500);
</script>
