---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/starwind/Button.astro';
import Badge from '@/components/starwind/Badge.astro';
import SectorCard from '@/components/SectorCard.astro';
import RouteCard from '@/components/RouteCard.astro';
import TopoCard from '@/components/TopoCard.astro';
import Map from '@/components/Map.astro';
import ContactForm from '@/components/ContactForm.astro';
const sectors=(await getCollection('sectors')).sort((a,b)=>a.data.order-b.data.order);
const sectorCount=new Set(sectors.map(s=>s.data.number)).size;
const allRoutes=await getCollection('routes');
const allTopos=await getCollection('topos');
const generalTopos=allTopos.filter(topo=>!topo.data.routeCard&&!topo.data.sector&&topo.data.sectors.length>0).sort((a,b)=>a.data.order-b.data.order);
const routeTopos=allTopos.filter(topo=>topo.data.routeCard);
const routes=allRoutes.filter(r=>r.data.featured).slice(0,3);
const sectorNumbers=Object.fromEntries(sectors.map(sector=>[sector.id,sector.data.number]));
const routeCounts=allRoutes.reduce<Record<string, number>>((counts, route)=>{ counts[route.data.sector]=(counts[route.data.sector]??0)+1; return counts; },{});
---
<BaseLayout title="Los Colorados" description="Guía comunitaria de escalada deportiva en Los Colorados, Barreal, San Juan, Argentina.">
  <section class="relative min-h-[88svh] overflow-hidden bg-basalt-950 text-white">
    <img src="/media/fotos/los-colorados-general-2.jpg" alt="Escalador en Los Colorados con la cordillera de los Andes al fondo" width="1280" height="960" loading="eager" fetchpriority="high" class="absolute inset-0 size-full object-cover object-top opacity-90" />
    <div class="absolute inset-0 bg-gradient-to-r from-basalt-950/80 via-basalt-950/35 to-transparent"></div><div class="absolute inset-0 bg-gradient-to-t from-basalt-950/75 via-transparent to-black/20"></div>
    <div class="container-guide relative flex min-h-[88svh] items-end pb-16 pt-32"><div class="max-w-4xl"><div class="flex flex-wrap items-center gap-2"><Badge tone="accent">Guía offline</Badge><button type="button" data-install-app="true" aria-describedby="install-status-hero" class="focus-ring inline-flex cursor-pointer items-center rounded-md border border-white/30 px-2.5 py-1 text-[.68rem] font-extrabold uppercase tracking-wider transition hover:bg-white/10 disabled:cursor-default disabled:opacity-60">Instalar guía <span class="ml-1" aria-hidden="true">↓</span></button></div><p id="install-status-hero" class="mt-3 hidden max-w-xl text-xs font-semibold leading-5 text-white/75" role="status" aria-live="polite"></p><h1 class="display mt-6 text-[clamp(4.8rem,15vw,11rem)]">Los<br/>Colorados</h1><p class="mt-5 max-w-2xl text-lg leading-8 text-white/75 md:text-xl">Escalada deportiva en roca volcánica, a cuatro kilómetros de Barreal. Siete sectores, aproximaciones cortas y una comunidad que cuida el lugar.</p><div class="mt-8 flex flex-wrap gap-3"><Button href="/sectores/">Explorar sectores <span aria-hidden="true">→</span></Button><Button href="/informacion/" variant="outline">Antes de escalar</Button></div><div class="mt-14 flex max-w-md flex-wrap items-baseline gap-x-8 gap-y-3 border-t border-white/20 pt-6"><div class="flex items-baseline gap-2"><strong class="text-2xl">{sectorCount}</strong><span class="text-xs uppercase tracking-widest text-white/55">Sectores</span></div><div class="flex items-baseline gap-2"><strong class="text-2xl">78</strong><span class="text-xs uppercase tracking-widest text-white/55">Vías declaradas</span></div></div></div></div>
  </section>
  <section class="container-guide py-24"><div class="mb-10 flex items-end justify-between gap-5"><div><p class="eyebrow text-clay-500">Conoce los sectores de Colorados</p><h2 class="display mt-3 text-5xl md:text-7xl">Sectores</h2></div><a class="hidden text-sm font-black underline underline-offset-4 sm:block" href="/sectores/">Ver todos →</a></div>{generalTopos.length > 0 && <div class="mb-8 grid gap-5 md:grid-cols-2">{generalTopos.map(topo=><TopoCard topo={topo} sectorName="Colorados · Ubicación general" />)}</div>}<div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">{sectors.map(sector=><SectorCard sector={sector} routeCount={routeCounts[sector.id] ?? 0} />)}</div></section>
  {routes.length > 0 && <section class="bg-basalt-900 py-24 text-white"><div class="container-guide"><div class="grid items-end gap-8 md:grid-cols-2"><div><p class="eyebrow text-clay-500">Vías destacadas</p><h2 class="display mt-3 text-5xl md:text-7xl">Líneas que<br/>merecen el viaje</h2></div><p class="max-w-md leading-7 text-white/60 md:justify-self-end">Información revisada para preparar la escalada y consultar offline.</p></div><div class="mt-12 grid gap-5 md:grid-cols-3">{routes.map(route=><RouteCard route={route} sectorNumber={sectorNumbers[route.data.sector]} topos={routeTopos.filter(topo=>topo.data.routes.includes(route.id))} />)}</div><div class="mt-10"><Button href="/vias/" variant="outline">Buscar todas las vías →</Button></div></div></section>}
  <section class="container-guide py-24"><Map /></section>
  <section class="container-guide pb-24"><div class="grid items-start gap-10 lg:grid-cols-[.8fr_1.2fr]"><div class="lg:sticky lg:top-8"><p class="eyebrow text-clay-500">Contacto y colaboración</p><h2 class="display mt-3 text-5xl md:text-7xl">La guía se construye entre todos.</h2><p class="mt-6 max-w-lg leading-7 opacity-65">¿Conoces una vía, encontraste un error o quieres colaborar con fotografías y croquis? Escríbenos. Si estás sin cobertura, guardaremos el mensaje para enviarlo después.</p></div><ContactForm compact /></div></section>
  <section id="instalar-guia" class="container-guide scroll-mt-6"><div class="rounded-3xl bg-clay-600 p-8 text-basalt-950 md:p-14"><div class="grid items-end gap-8 md:grid-cols-2"><div><p class="eyebrow">La guía en tu bolsillo</p><h2 class="display mt-3 text-5xl">Prepárala online.<br/>Úsala offline.</h2></div><div><p class="max-w-md leading-7">Instala Colorados antes de entrar a la quebrada. Las páginas visitadas, croquis e imágenes esenciales quedan disponibles sin cobertura.</p><Button class="mt-6 bg-white !text-basalt-900 hover:bg-stone-100" id="install-app" data-install-app="true" aria-describedby="install-status">Instalar la guía</Button><p id="install-status" class="mt-4 hidden max-w-md text-sm font-semibold leading-6" role="status" aria-live="polite"></p></div></div></div></section>
</BaseLayout>
<script is:inline>
  let installPrompt;
  const installButtons = [...document.querySelectorAll('[data-install-app]')];
  const installStatuses = [
    document.getElementById('install-status-hero'),
    document.getElementById('install-status'),
  ].filter(Boolean);
  const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
  const isStandalone = matchMedia('(display-mode: standalone)').matches || navigator.standalone === true;

  function showInstallStatus(message) {
    installStatuses.forEach((status) => {
      status.textContent = message;
      status.classList.remove('hidden');
    });
  }

  function markAsInstalled() {
    installButtons.forEach((button) => {
      button.textContent = 'Guía instalada';
      button.setAttribute('disabled', '');
    });
  }

  if (isStandalone) markAsInstalled();

  addEventListener('beforeinstallprompt', (event) => {
    event.preventDefault();
    installPrompt = event;
  });

  installButtons.forEach((button) => {
    button.addEventListener('click', async () => {
      if (isStandalone) return;
      if (installPrompt) {
        await installPrompt.prompt();
        const choice = await installPrompt.userChoice;
        if (choice.outcome === 'accepted') showInstallStatus('La instalación comenzó. Colorados aparecerá entre tus aplicaciones.');
        installPrompt = undefined;
        return;
      }
      if (isIOS) {
        showInstallStatus('En iPhone o iPad: toca Compartir y luego “Añadir a pantalla de inicio”.');
        return;
      }
      showInstallStatus('Abre el menú de tu navegador y selecciona “Instalar aplicación” o “Añadir a pantalla de inicio”.');
    });
  });

  addEventListener('appinstalled', () => {
    markAsInstalled();
    showInstallStatus('Colorados quedó instalada y lista para usar.');
  });
</script>
