---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ContactForm from '@/components/ContactForm.astro';
---
<BaseLayout title="Contacto" description="Contacto del Club Andino Barreal para correcciones, condiciones y aportes a la guía de Los Colorados.">
  <section class="bg-basalt-900 pb-14 pt-32 text-white">
    <div class="container-guide">
      <Breadcrumbs items={[{ label: 'Contacto' }]} />
      <p class="eyebrow mt-14 text-clay-500">Aporta a la guía</p>
      <h1 class="display mt-3 text-6xl md:text-8xl">Hablemos</h1>
      <p class="mt-5 max-w-2xl text-lg text-white/65">Reporta condiciones, errores en una ficha o información que ayude a mantener la guía actualizada.</p>
    </div>
  </section>

  <section class="container-guide py-16">
    <div class="grid gap-10 lg:grid-cols-[1fr_22rem]">
      <ContactForm />

      <aside class="card h-fit p-6">
        <p class="eyebrow opacity-50">Funciona sin cobertura</p>
        <h2 class="mt-4 text-2xl font-black">Escribe ahora, envía después</h2>
        <p class="mt-3 text-sm leading-6 opacity-65">Si estás offline, el mensaje queda guardado únicamente en este dispositivo. Intentaremos enviarlo al recuperar conexión o al volver a abrir la guía.</p>
        <p class="mt-5 border-t border-current/10 pt-5 text-sm leading-6">También podés escribir a <a class="font-bold underline underline-offset-4" href="mailto:andinobarreal@gmail.com">andinobarreal@gmail.com</a> o seguir a <a class="font-bold underline underline-offset-4" href="https://www.instagram.com/clubandinobarreal/" target="_blank" rel="noopener noreferrer">@clubandinobarreal</a>.</p>
      </aside>
    </div>
  </section>
</BaseLayout>
