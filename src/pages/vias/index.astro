---
import { getCollection } from 'astro:content'; import BaseLayout from '@/layouts/BaseLayout.astro'; import Breadcrumbs from '@/components/Breadcrumbs.astro'; import RouteCard from '@/components/RouteCard.astro';
const sectors=(await getCollection('sectors')).sort((a,b)=>a.data.order-b.data.order); const sectorOrder=Object.fromEntries(sectors.map(s=>[s.id,s.data.order])); const sectorNumbers=Object.fromEntries(sectors.map(s=>[s.id,s.data.number])); const routes=(await getCollection('routes')).sort((a,b)=>(sectorOrder[a.data.sector]??999)-(sectorOrder[b.data.sector]??999)||(a.data.order??999)-(b.data.order??999)); const routeTopos=(await getCollection('topos')).filter(topo=>topo.data.routeCard);
---
<BaseLayout title="Vías" description="Vías de escalada deportiva de Los Colorados, Barreal, San Juan."><section class="bg-basalt-900 pb-14 pt-32 text-white"><div class="container-guide"><Breadcrumbs items={[{label:'Vías'}]}/><p class="eyebrow mt-14 text-clay-500">78 vías declaradas · 79 entradas transcritas</p><h1 class="display mt-3 text-6xl md:text-8xl">Encuentra tu vía</h1></div></section><section class="container-guide py-12"><div class="card grid gap-4 p-4 md:grid-cols-3"><label class="md:col-span-2"><span class="sr-only">Buscar por nombre o grado</span><input id="route-search" class="focus-ring h-12 w-full rounded-xl border border-current/15 bg-transparent px-4" type="search" placeholder="Buscar por nombre o grado…"/></label><label><span class="sr-only">Sector</span><select id="sector-filter" class="focus-ring h-12 w-full rounded-xl border border-current/15 bg-transparent px-3"><option value="">Todos los sectores</option>{sectors.map(s => <option value={s.id}>Sector {s.data.number} · {s.data.name}</option>)}</select></label></div><p id="result-count" class="my-6 text-sm font-bold opacity-55">{routes.length} resultados</p><div id="routes-grid" class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">{routes.map(r=><RouteCard route={r} sectorNumber={sectorNumbers[r.data.sector]} topos={routeTopos.filter(topo=>topo.data.routes.includes(r.id))} />)}</div><p id="no-results" class="card mt-5 hidden p-8 text-center">No encontramos vías con esos filtros.</p></section></BaseLayout>
<script is:inline>
const inputs=['route-search','sector-filter'].map(id=>document.getElementById(id));const cards=[...document.querySelectorAll('.route-card')];function filter(){const q=inputs[0].value.toLowerCase(),sector=inputs[1].value;let n=0;cards.forEach(c=>{const ok=c.dataset.search.includes(q)&&(!sector||c.dataset.sector===sector);c.classList.toggle('hidden',!ok);if(ok)n++});document.getElementById('result-count').textContent=`${n} ${n===1?'resultado':'resultados'}`;document.getElementById('no-results').classList.toggle('hidden',n>0)}inputs.forEach(i=>i.addEventListener('input',filter));
</script>
